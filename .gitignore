# Firmware (ESP-IDF). Cada projeto pode ter regras extras no próprio .gitignore.
build/
managed_components/
sdkconfig
sdkconfig.old
compile_commands.json
.clangd/
.cache/

# Central: passwords and tokens (copy interface/.env.example)
interface/.env

# Raw sensor recordings (docs/coleta-de-dados.md): too large for git; keep only dados/README.md
dados/*
!dados/README.md

# Model scores regenerated by modelo/experimentos/03_comparar.py (tables and figures stay versioned)
modelo/resultados/*.npz
modelo/.pytest_cache/

# Python
.venv/
venv/
__pycache__/
*.pyc

# LaTeX: arquivos de build (o PDF final continua versionado)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
relatorios/**/*.log

# Hardware: backups e arquivos temporários das ferramentas de EDA (.history = histórico local do KiCad, um repositório git)
*-backups/
.history/
*.bak
*.lck
fp-info-cache

# Editor e sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
