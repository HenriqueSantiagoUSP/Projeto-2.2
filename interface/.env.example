# Copy to .env and change every password. .env stays out of git.

# Broker passwords. The user names are fixed (hub, vestivel, telegraf, notificador, painel)
# because mosquitto/acl refers to them. The hub firmware and the simulator use "hub";
# a wearable with the optional MQTT link uses "vestivel".
MQTT_HUB_PASSWORD=troque-hub
MQTT_VESTIVEL_PASSWORD=troque-vestivel
MQTT_TELEGRAF_PASSWORD=troque-telegraf
MQTT_NOTIFICADOR_PASSWORD=troque-notificador
MQTT_PAINEL_PASSWORD=troque-painel

# InfluxDB, created on the first start. The password needs at least 8 characters.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=troque-influx
INFLUX_ORG=ilpi
INFLUX_BUCKET=monitoramento
INFLUX_TOKEN=troque-este-token-por-um-longo-e-aleatorio

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-grafana

# Telegram bot (create it with @BotFather) and the caregiver's chat.
# Left empty, the notifier only prints the alerts it would send.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
